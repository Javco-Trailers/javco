# Copy to .env.local (and set in Vercel project settings).

# Google Maps Embed API key for the location map (place embed of the Javco listing).
# It is shipped to the browser, so restrict it in Google Cloud to the Maps Embed API and javco.co referrers.
# Optional: without it the map falls back to a keyless address embed.
NEXT_PUBLIC_MAPS=

# Google Search Console ownership check for the https://www.javco.co/ URL-prefix property (HTML tag method).
# Paste only the content="..." value from the meta tag Google gives you, then redeploy.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
