{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "extends": ["config:recommended"],
    "schedule": ["after 10am on monday"],
    "minimumReleaseAge": "14 days",
    "prConcurrentLimit": 3,
    "rangeStrategy": "bump",
    "packageRules": [
        {
            "groupName": "eslint",
            "matchPackageNames": ["eslint", "/eslint-/", "/^@eslint//", "typescript-eslint", "@stylistic/eslint-plugin"]
        },
        {
            "groupName": "minor and patch",
            "matchUpdateTypes": ["minor", "patch"]
        }
    ]
}
